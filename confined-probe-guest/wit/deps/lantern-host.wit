// Vendored copy of `lantern-runtime`'s own `wit/host.wit` — just the `keystore`
// interface this probe actually imports. Keep in lockstep with:
//   ../../wit/host.wit
// RFC-0014/ADR-0018 fixes the contract `lantern-runtime::build_linker` satisfies.

package lantern:host@0.1.0;

/// LanternOS-owned. Resource-scoped: one host capability record per `key` handle.
interface keystore {
    /// Relayed verbatim from the owning crypto service's own deny-by-default check.
    enum error-code {
        /// The badge behind this handle was denied by the crypto service: unknown,
        /// revoked, scoped to a different key, or not granted this operation.
        access,
        /// The arguments were malformed, or the underlying primitive rejected them.
        invalid,
    }

    /// A capability to one key held by the crypto service, scoped to the operation
    /// subset the manifest granted. Methods forward to the service, which re-checks
    /// the badge on every call.
    resource key {
        /// XChaCha20-Poly1305, detached. Returns `(ciphertext, tag)`.
        encrypt: func(nonce: list<u8>, aad: list<u8>, plaintext: list<u8>)
            -> result<tuple<list<u8>, list<u8>>, error-code>;
        /// XChaCha20-Poly1305, detached. `tag` is the detached authentication tag.
        decrypt: func(nonce: list<u8>, aad: list<u8>, ciphertext: list<u8>, tag: list<u8>)
            -> result<list<u8>, error-code>;
        /// Ed25519. Returns the 64-byte signature.
        sign: func(message: list<u8>) -> result<list<u8>, error-code>;
    }

    /// The ONLY way a component obtains a `key`. `slot` indexes the capability
    /// manifest's explicit grant list — not any ambient namespace. `none` is returned
    /// for a slot the manifest left empty.
    open: func(slot: u32) -> option<key>;
}
